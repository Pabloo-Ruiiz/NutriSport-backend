# .env.example — copia este fichero a .env y cambia los valores
DB_USER=nutrisport_usr
DB_PASS=cambia_esta_clave
JWT_SECRET=genera_uno_con_openssl_rand_base64_48
MINIO_USER=nutrisport_minio
MINIO_PASS=cambia_esta_clave_minio
ADMIN_EMAIL=admin@nutrisport.local
ADMIN_PASS=cambia_esta_clave_admin
IA_API_KEY=

# Open Food Facts (lectura sin clave; User-Agent obligatorio con un correo de contacto, §3.3 de API_INTEGRATIONS.md)
# En desarrollo se usa siempre staging (world.openfoodfacts.net, autenticación básica off/off).
# Producción: https://world.openfoodfacts.org
OFF_BASE_URL=https://world.openfoodfacts.net
OFF_SEARCH_URL=https://search.openfoodfacts.org
OFF_USER_AGENT=NutriSport/0.1 (pon-aqui-tu-correo-de-contacto)
OFF_STAGING_USER=off
OFF_STAGING_PASS=off

# TheMealDB (§4 de API_INTEGRATIONS.md). La clave va en la ruta: {THEMEALDB_BASE_URL}/{THEMEALDB_API_KEY}/search.php
# La clave de prueba "1" solo vale para desarrollo y uso educativo; publicar en una tienda exige la de supporter.
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1
THEMEALDB_API_KEY=1

# USDA FoodData Central (§5 de API_INTEGRATIONS.md): nutrientes de ingredientes genéricos para calcular recetas.
# Clave personal y gratuita: https://fdc.nal.usda.gov/api-key-signup (1000 peticiones/hora). No la publiques.
# DEMO_KEY solo admite 30 peticiones/hora y 50/día: úsala únicamente para una prueba rápida.
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_API_KEY=
